# --- BareMetal app build outputs (regenerated by `make`) ---
/src/app/*.o
/src/app/*.d
/src/app/*.elf
/src/app/*.img
/src/app/*.lst
/src/app/*.map

# --- host-test: keep sources and reference ROMs, ignore compiled tools + logs ---
/host-test/*
!/host-test/*.c
!/host-test/*.cpp
!/host-test/*.h
!/host-test/*.bin
!/host-test/*.asm
