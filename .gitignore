# --- BareMetal app build outputs (regenerated by `make`) ---
/src/app/*.o
/src/app/*.d
/src/app/*.elf
/src/app/*.img
/src/app/*.lst
/src/app/*.map

# --- host-test: keep sources and reference ROMs, ignore compiled tools + logs ---
/host-test/*
!/host-test/*.c
!/host-test/*.cpp
!/host-test/*.h
!/host-test/*.bin
!/host-test/*.asm
!/host-test/run_v9938_test.sh

# Circle FAT host regression sources (compiled binary and caches stay ignored).
!/host-test/circle_fat/
/host-test/circle_fat/*
!/host-test/circle_fat/*.cpp
!/host-test/circle_fat/*.py
!/host-test/circle_fat/*.sh
!/host-test/circle_fat/stub/
!/host-test/circle_fat/stub/circle/
!/host-test/circle_fat/stub/circle/*.h
